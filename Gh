ai_engine/config/agents.yaml

# Global defaults to prevent duplication
defaults:
  provider: "openai"
  model_name: "gpt-4o"
  temperature: 0.2
  max_tokens: 1500

# Agent-specific overrides based on their specialized tasks
agents:
  commentary_generator:
    provider: "openai"
    model_name: "gpt-4o"
    temperature: 0.3         # Slightly higher for narrative fluidity
    max_tokens: 4000         # High ceiling to support up to 3k words

  compliance_critic:
    provider: "anthropic"    # Can effortlessly mix and match providers
    model_name: "claude-3-5-sonnet"
    temperature: 0.0         # Hard zero for strict deterministic auditing
    max_tokens: 2000

  json_fixer:
    provider: "openai"
    model_name: "gpt-4o-mini" # Cheaper, faster model for simple syntax corrections
    temperature: 0.0
    max_tokens: 1000
