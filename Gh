import yaml
from pathlib import Path

class PromptTemplateManager:
    def __init__(self, templates_dir: str = "ai_engine/prompts/templates"):
        # Resolve path dynamically relative to file location if needed
        self.templates_dir = Path(templates_dir)

    def generate_system_prompt(self, risk_type: str, location: str) -> str:
        """
        Dynamically maps a risk type string to its corresponding YAML file 
        and executes token interpolation for local compliance routing.
        """
        # Normalize: "Market Risk" -> "market_risk.yaml"
        file_name = f"{risk_type.lower().replace(' ', '_')}.yaml"
        file_path = self.templates_dir / file_name

        if not file_path.exists():
            raise FileNotFoundError(
                f"Configuration mapping failure: No prompt template YAML found "
                f"at {file_path} for Risk Type: '{risk_type}'."
            )

        with open(file_path, "r", encoding="utf-8") as f:
            config = yaml.safe_load(f)

        base_persona = config.get("system_persona", "")
        
        # Inject dynamic runtime variables safely
        return base_persona.format(location=location)
